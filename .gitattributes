* text=auto
*.cpp text eol=lf
*.hpp text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.fbs text eol=lf
*.cmake text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
CMakeLists.txt text eol=lf
.gitignore text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
