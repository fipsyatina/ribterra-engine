namespace ribterra.save;

enum Terrain : byte { Grass, Water, Forest, Rock, MineFloor, MineOre }
enum BuildingKind : byte { Camp, House, Farm, Stockpile }
enum Job : byte { Idle, Move, Woodcut, Mine, Forage, Build }
enum Layer : byte { Surface, Mine }
enum OrderPhase : byte { Idle, PathPending, Active, PathFailed }
enum PathFailure : byte { None, Unreachable, Timeout, TopologyChanged, LimitExceeded, ResidentUnavailable, TargetInvalid, ReservationConflict }
enum PathCommandKind : byte { Move, Gather, Build, Replan }
enum PathPlannerPhase : byte { Queued, Search, Reconstruct, Stage }

struct Point {
  x:short;
  y:short;
}

struct Cell {
  x:short;
  y:short;
  layer:Layer;
}

table Metadata {
  world_id:[ubyte] (required);
  seed:uint;
  ticks:ulong;
  next_building_id:int;
  has_moved:bool;
  has_gathered:bool;
  has_built:bool;
}

table Resources {
  wood:int;
  stone:int;
  food:int;
}

table Tile {
  terrain:Terrain;
  amount:int;
  explored:bool;
}

table Resident {
  id:int;
  name:string (required);
  x:float;
  y:float;
  target_x:int;
  target_y:int;
  job:Job;
  progress:float;
  health:int;
  hunger:float;
  wood_xp:int;
  mining_xp:int;
  farming_xp:int;
  layer:Layer = Surface;
  nation:uint = 1;
  order_phase:OrderPhase = Idle;
  path_failure:PathFailure = None;
  pending_path_batch:ulong;
}

table Building {
  id:int;
  kind:BuildingKind;
  x:int;
  y:int;
  progress:float;
  layer:Layer = Surface;
  nation:uint = 1;
}

table Route {
  points:[Point];
  cursor:uint;
  work_x:int = -1;
  work_y:int = -1;
  resident_id:int;
  cells:[Cell];
  work:Cell;
}

table Chunk {
  layer:Layer;
  cx:short;
  cy:short;
  revision:ulong;
  tiles:[Tile] (required);
}

table Portal {
  first:Cell;
  second:Cell;
}

table PathSearchNode {
  cell:Cell;
  next:Cell;
}

table PathRouteDraft {
  resident_id:int;
  start:Cell;
  start_x:float;
  start_y:float;
  storage_reserved:bool;
  reconstruction_cursor:Cell;
  staged:[Cell];
}

table PathBatch {
  path_batch_id:ulong;
  command:PathCommandKind;
  phase:PathPlannerPhase;
  resident_ids:[int];
  target:Cell;
  to_adjacent:bool;
  assigned_job:Job;
  build_kind:BuildingKind = null;
  building_id:int;
  reserved_cost:Resources;
  enqueued_tick:ulong;
  deadline_tick:ulong;
  search_topology_revision:ulong;
  restart_count:ubyte;
  work_units_done:ulong;
  roots:[Cell];
  search_storage_reserved:bool;
  frontier:[Cell];
  frontier_cursor:ulong;
  nodes:[PathSearchNode];
  drafts:[PathRouteDraft];
  reconstruction_resident:ulong;
  stage_cursor:ulong;
}

table PathBatchOutcome {
  path_batch_id:ulong;
  command:PathCommandKind;
  accepted:bool;
  failure:PathFailure;
  message:string;
}

table WorldSave {
  metadata:Metadata (required);
  resources:Resources (required);
  tiles:[Tile] (required);
  residents:[Resident] (required);
  buildings:[Building] (required);
  routes:[Route] (required);
  events:[string] (required);
  chunks:[Chunk];
  portals:[Portal];
  next_path_batch_id:ulong = 1;
  topology_revision:ulong;
  path_batches:[PathBatch];
  path_results:[PathBatchOutcome];
}

root_type WorldSave;
file_identifier "RBTW";
