namespace ribterra.save;

enum Terrain : byte { Grass, Water, Forest, Rock, MineFloor, MineOre }
enum BuildingKind : byte { Camp, House, Farm, Stockpile, Mine, Workshop, Temple, Tavern, Cartographer, Research, Smelter, Fishing, Library, Barracks, Bridge }
enum Job : byte { Idle, Move, Woodcut, Mine, Forage, Build, Haul, Farm }
enum Layer : byte { Surface, Mine }
enum OrderPhase : byte { Idle, PathPending, Active, PathFailed }
enum PathFailure : byte { None, Unreachable, Timeout, TopologyChanged, LimitExceeded, ResidentUnavailable, TargetInvalid, ReservationConflict }
enum PathCommandKind : byte { Move, Gather, Build, Replan, Logistics, Work, Manual }
enum PathPlannerPhase : byte { Queued, Search, Reconstruct, Stage }
enum ItemKind : ubyte { Wood, Stone, Food }
enum ItemLocationKind : ubyte { Ground, Storage, Carried, Construction }
enum LogisticsTaskKind : ubyte { HaulToStorage, DeliverConstruction }
enum LogisticsPhase : ubyte { Queued, ToPickup, ToDropoff, Complete, Failed }
enum LogisticsFailure : ubyte { None, Unreachable, Timeout, ResidentUnavailable, StorageFull, Cancelled, LimitExceeded, TargetInvalid }
enum ConstructionPhase : ubyte { Planned, Delivery, Work, Complete, Cancelled }
enum WorkIntentKind : ubyte { GatherContinuation, BuildAssignment }
enum WorkIntentPhase : ubyte { Waiting, PathPending, Complete, Failed }
enum WorkCompletionReason : ubyte { None, Started, Exhausted, Superseded, Cancelled }
enum Profession : ubyte { Unassigned, Woodcutter, Miner, Forager, Builder, Hauler, Farmer, Smith, Medic, Guard }
enum ProfessionWaitReason : ubyte { None, Unassigned, Stopped, ManualOrder, DeliveryBoundary, NoCompatibleWork, WorksiteUnavailable, QueuePressure, PathFailed, Incapacitated, PendingOrder, Strolling, Socializing, SelfGathering }
enum ManualOrderKind : ubyte { Move, Gather, Legacy }
enum GatherCompletion : ubyte { UntilExhausted, OneDelivery }
enum ManualOrderPhase : ubyte { Queued, WaitingBoundary, PathPending, Active, Complete, Failed, Cancelled }
enum ManualOrderCompletion : ubyte { None, Arrived, Delivered, Exhausted, Replaced, Stopped, Released, LegacyFinished, Cancelled }
enum ManualExecutorKind : ubyte { None, Path, Route, Work, Logistics }
enum ClimateProfileId : ushort { TemperateValley = 1 }
enum ClimateScenarioId : ushort { Standard = 0, FirstWinterStorm = 1 }
enum WeatherKind : ubyte { Clear, Cloudy, Precipitation, Storm }
enum PrecipitationKind : ubyte { None, Rain, Snow }
enum WindDirection : ubyte { N, NE, E, SE, S, SW, W, NW }
enum WeatherWorkReason : ubyte { None, Cold, Rain, Snow, Storm }

struct Point {
  x:short;
  y:short;
}

struct Cell {
  x:short;
  y:short;
  layer:Layer;
}

table Metadata {
  world_id:[ubyte] (required);
  seed:uint;
  ticks:ulong;
  next_building_id:int;
  has_moved:bool;
  has_gathered:bool;
  has_built:bool;
}

table Resources {
  wood:int;
  stone:int;
  food:int;
}

table Tile {
  terrain:Terrain;
  amount:int;
  explored:bool;
  biome:ubyte;
  elevation:short;
  trail_wear:ubyte;
}

table SkillPractice {
  experience_remainder:uint;
  familiarity_debt:uint;
  last_practice_tick:ulong;
}

table ProfessionState {
  profession:Profession;
  worksite:Cell;
  priorities:[ubyte];
  automation_enabled:bool = true;
  manual_override:bool;
  deferred:bool;
  wait_reason:ProfessionWaitReason = Unassigned;
  next_evaluation_tick:ulong;
}

table Resident {
  id:int;
  name:string (required);
  x:float;
  y:float;
  target_x:int;
  target_y:int;
  job:Job;
  progress:float;
  health:int;
  hunger:float;
  wood_xp:int;
  mining_xp:int;
  farming_xp:int;
  layer:Layer = Surface;
  nation:uint = 1;
  order_phase:OrderPhase = Idle;
  path_failure:PathFailure = None;
  pending_path_batch:ulong;
  additional_xp:[int];
  skill_practice:[SkillPractice];
  abilities_bp:[short];
  profession:ProfessionState;
}

table Building {
  id:int;
  kind:BuildingKind;
  x:int;
  y:int;
  progress:float;
  layer:Layer = Surface;
  nation:uint = 1;
}

table Route {
  points:[Point];
  cursor:uint;
  work_x:int = -1;
  work_y:int = -1;
  resident_id:int;
  cells:[Cell];
  work:Cell;
}

table Chunk {
  layer:Layer;
  cx:short;
  cy:short;
  revision:ulong;
  tiles:[Tile] (required);
}

table Portal {
  first:Cell;
  second:Cell;
}

table PathSearchNode {
  cell:Cell;
  next:Cell;
}

table PathRouteDraft {
  resident_id:int;
  start:Cell;
  start_x:float;
  start_y:float;
  storage_reserved:bool;
  reconstruction_cursor:Cell;
  staged:[Cell];
  manual_order_id:ulong;
  resolved:bool;
  failure:PathFailure;
}

table PathBatch {
  path_batch_id:ulong;
  command:PathCommandKind;
  phase:PathPlannerPhase;
  resident_ids:[int];
  target:Cell;
  to_adjacent:bool;
  assigned_job:Job;
  build_kind:BuildingKind = null;
  building_id:int;
  reserved_cost:Resources;
  enqueued_tick:ulong;
  deadline_tick:ulong;
  search_topology_revision:ulong;
  restart_count:ubyte;
  work_units_done:ulong;
  roots:[Cell];
  search_storage_reserved:bool;
  frontier:[Cell];
  frontier_cursor:ulong;
  nodes:[PathSearchNode];
  drafts:[PathRouteDraft];
  reconstruction_resident:ulong;
  stage_cursor:ulong;
  legacy_atomic:bool = true;
  legacy_grid:bool;
}

table PathBatchOutcome {
  path_batch_id:ulong;
  command:PathCommandKind;
  accepted:bool;
  failure:PathFailure;
  message:string;
}

table ItemStack {
  stack_id:ulong;
  item:ItemKind;
  quantity:uint;
  owner_nation:uint = 1;
  location_kind:ItemLocationKind;
  cell:Cell;
  entity_id:int;
}

table Storage {
  building_id:int;
  capacity:uint;
  accepted_items:ubyte;
  priority:int;
}

table ItemReservation {
  reservation_id:ulong;
  stack_id:ulong;
  task_id:ulong;
  quantity:uint;
  owner_nation:uint = 1;
}

table LogisticsTask {
  task_id:ulong;
  kind:LogisticsTaskKind;
  phase:LogisticsPhase;
  failure:LogisticsFailure;
  resident_id:int;
  destination_building_id:int;
  source_stack_id:ulong;
  reservation_id:ulong;
  carry_stack_id:ulong;
  path_batch_id:ulong;
  item:ItemKind;
  quantity:uint;
  deadline_tick:ulong;
  resume_job:Job;
  resume_target:Cell;
}

table ConstructionOrder {
  building_id:int;
  kind:BuildingKind;
  site:Cell;
  owner_nation:uint = 1;
  required:Resources (required);
  delivered:Resources (required);
  phase:ConstructionPhase;
  originating_path_batch_id:ulong;
}

table WorkIntent {
  intent_id:ulong;
  kind:WorkIntentKind;
  phase:WorkIntentPhase;
  completion:WorkCompletionReason;
  failure:PathFailure;
  resident_id:int;
  building_id:int;
  owner_nation:uint = 1;
  target:Cell;
  job:Job;
  expected_terrain:Terrain;
  created_tick:ulong;
  next_attempt_tick:ulong;
  admission_deadline_tick:ulong;
  path_batch_id:ulong;
  attempts:ushort;
  last_attempt_topology_revision:ulong;
}

table ManualOrderIssuer {
  player_id:ulong;
  request_id:ulong;
}

table ManualOrder {
  order_id:ulong;
  resident_id:int;
  owner_nation:uint = 1;
  kind:ManualOrderKind;
  target:Cell;
  gather_completion:GatherCompletion;
  phase:ManualOrderPhase;
  failure:PathFailure;
  completion:ManualOrderCompletion;
  issuer:ManualOrderIssuer;
  issued_tick:ulong = null;
  legacy_compatibility:bool;
  executor:ManualExecutorKind;
  executor_id:ulong;
  activated_tick:ulong = null;
  next_attempt_tick:ulong;
  attempts:ushort;
}

struct YoungResident { resident_id:int; adult_tick:ulong; forced_work:bool; }
table Settlement { revision:ulong; arrival_tick:ulong; forced_night:ulong; night_discontent:int; youth_discontent:int; young:[YoungResident]; reduced_rations:bool; }

table WeatherSample {
  kind:WeatherKind;
  precipitation:PrecipitationKind;
  wind_direction:WindDirection;
  work_reason:WeatherWorkReason;
  temperature_deci_c:short;
  precipitation_permille:ushort;
  wind_permille:ushort;
  outdoor_work_rate_bp:ushort;
  period_start_calendar_tick:ulong;
  period_end_calendar_tick:ulong;
}

table OutdoorWorkRemainder {
  resident_id:int;
  job:Job;
  target:Cell (required);
  building_id:int;
  remainder_bp:ushort;
}

table ClimateRuntime {
  algorithm_version:ushort;
  climate_profile:ClimateProfileId = TemperateValley;
  scenario:ClimateScenarioId = Standard;
  calendar_offset_ticks:ulong;
  evaluated_simulation_tick:ulong;
  current:WeatherSample (required);
  snow_cover_permille:ushort;
  snow_cover_remainder:long;
  wetness_permille:ushort;
  wetness_remainder:long;
  outdoor_work_remainders:[OutdoorWorkRemainder] (required);
}

table WorldSave {
  metadata:Metadata (required);
  resources:Resources (required);
  tiles:[Tile] (required);
  residents:[Resident] (required);
  buildings:[Building] (required);
  routes:[Route] (required);
  events:[string] (required);
  chunks:[Chunk];
  portals:[Portal];
  next_path_batch_id:ulong = 1;
  topology_revision:ulong;
  path_batches:[PathBatch];
  path_results:[PathBatchOutcome];
  next_item_stack_id:ulong = 1;
  next_item_reservation_id:ulong = 1;
  next_logistics_task_id:ulong = 1;
  item_stacks:[ItemStack];
  storages:[Storage];
  item_reservations:[ItemReservation];
  logistics_tasks:[LogisticsTask];
  construction_orders:[ConstructionOrder];
  next_work_intent_id:ulong = 1;
  work_intent_cursor_id:ulong = 1;
  work_building_cursor_id:int = 1;
  work_intents:[WorkIntent];
  profession_cursor_id:int = 1;
  next_manual_order_id:ulong = 1;
  manual_order_cursor_id:ulong = 1;
  manual_orders:[ManualOrder];
  settlement:Settlement;
  economy:string;
  server_metadata:string;
  climate:ClimateRuntime (required);
}

root_type WorldSave;
file_identifier "RBTW";
