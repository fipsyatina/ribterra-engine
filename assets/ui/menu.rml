<rml><head><link type="text/rcss" href="ribterra.rcss"/><link type="text/rcss" href="art/theme.rcss"/><link type="text/rcss" href="concept.rcss"/></head><body class="screen">
<img id="menu-landscape" src="art/menu-landscape.png"/><div id="menu-card" class="card"><h1 id="app-title">Ribterra</h1><p id="menu-subtitle">Settlement strategy</p>
<button id="continue-game">Continue</button><button id="new-game">New settlement</button><button id="open-online">Online game</button><button id="menu-load">Load game</button><button id="open-settings">Settings</button><button id="open-help">Help</button><button id="quit-game">Quit</button></div>
<div id="menu-status" class="card"></div>
<div id="settings-card" class="card hidden"><h2 id="settings-title">Settings</h2><label id="language-label">Language</label><select id="language"><option value="en">English</option><option value="uk">Українська</option><option value="ru">Русский</option><option value="pl">Polski</option><option value="es">Español</option></select><label id="scale-label">Interface scale</label><select id="ui-scale"><option value="0.85">85%</option><option value="1">100%</option><option value="1.15">115%</option><option value="1.3">130%</option></select>
<h2 id="presentation-title" class="settings-section-title">Presentation</h2><label id="present-mode-label">Present mode</label><select id="present-mode"><option value="vsync">VSync</option><option value="immediate">Immediate</option><option value="mailbox">Mailbox</option></select><label id="fps-cap-label">FPS cap</label><select id="fps-cap"><option value="0">Uncapped</option><option value="60">60</option><option value="120">120</option><option value="144">144</option><option value="240">240</option><option value="0" class="hidden">0</option></select><label id="frames-in-flight-label">Frames in flight</label><select id="frames-in-flight"><option value="1">1</option><option value="2">2</option><option value="3">3</option></select><p id="presentation-requested"></p><p id="presentation-effective"></p><p id="presentation-explanation"></p><div id="presentation-actions"><button id="presentation-reset">Reset to active</button><button id="presentation-apply">Apply</button></div><button id="settings-back">Back</button></div>
<div id="help-card" class="card hidden"><h2 id="help-title">Field guide</h2><p id="help-body"></p><button id="help-back">Back</button></div>
<div id="online-card" class="card hidden"><img class="online-backdrop" src="art/lobby-hall.png"/>
<div id="online-content"><h1 id="online-title">Online game</h1><div id="online-roster">
<div id="online-seat-0" class="online-seat"><img src="art/lobby-portraits.png" rect="0 90 537 480"/><h2 id="online-seat-name-0"></h2><p id="online-seat-state-0"></p></div>
<div id="online-seat-1" class="online-seat"><img src="art/lobby-portraits.png" rect="1611 90 537 480"/><h2 id="online-seat-name-1"></h2><p id="online-seat-state-1"></p></div>
<div id="online-seat-2" class="online-seat"><img src="art/lobby-portraits.png" rect="1611 90 537 480"/><h2 id="online-seat-name-2"></h2><p id="online-seat-state-2"></p></div>
<div id="online-seat-3" class="online-seat"><img src="art/lobby-portraits.png" rect="1611 90 537 480"/><h2 id="online-seat-name-3"></h2><p id="online-seat-state-3"></p></div>
<div id="online-seat-4" class="online-seat"><img src="art/lobby-portraits.png" rect="1611 90 537 480"/><h2 id="online-seat-name-4"></h2><p id="online-seat-state-4"></p></div>
<div id="online-seat-5" class="online-seat"><img src="art/lobby-portraits.png" rect="1611 90 537 480"/><h2 id="online-seat-name-5"></h2><p id="online-seat-state-5"></p></div>
</div><div id="online-lower"><div id="online-valley"><img src="art/lobby-valley.png"/><div id="online-caption"></div></div><div id="online-settings"><h2 id="online-settings-title"></h2><label id="online-name-label">Player name</label><input id="online-name" type="text" value="Player" maxlength="24"/>
<label id="online-address-label">Server address (IP:port)</label><input id="online-address" type="text" value="127.0.0.1:27020" maxlength="128"/>
<label id="online-password-label">Password</label><input id="online-password" type="password" maxlength="64"/>
<label id="online-capacity-label">Places</label><select id="online-capacity"><option value="2">2</option><option value="3">3</option><option value="4" selected="selected">4</option><option value="5">5</option><option value="6">6</option></select>
</div></div><p id="online-help"></p><div id="online-actions"><button id="online-back">Back</button><button id="online-resume">Continue shared world</button><button id="online-join">Join</button><button id="online-host">Create shared world</button></div></div></div>
<div id="lobby-card" class="card hidden">
<img id="lobby-backdrop" src="art/lobby-hall.png"/>
<div id="lobby-content"><h1 id="lobby-title">Lobby</h1><div id="lobby-motto"></div>
<div id="lobby-players">
<div id="lobby-slot-0" class="lobby-slot"><div class="lobby-portrait"><img id="lobby-portrait-0" src="art/lobby-portraits.png"/></div><div class="lobby-slot-info"><h2 id="lobby-name-0"></h2><div id="lobby-state-0" class="lobby-state"></div><select id="lobby-bot-team-0" class="bot-team"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></select><button id="lobby-slot-action-0" class="slot-action"></button></div></div>
<div id="lobby-slot-1" class="lobby-slot"><div class="lobby-portrait"><img id="lobby-portrait-1" src="art/lobby-portraits.png"/></div><div class="lobby-slot-info"><h2 id="lobby-name-1"></h2><div id="lobby-state-1" class="lobby-state"></div><select id="lobby-bot-team-1" class="bot-team"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></select><button id="lobby-slot-action-1" class="slot-action"></button></div></div>
<div id="lobby-slot-2" class="lobby-slot"><div class="lobby-portrait"><img id="lobby-portrait-2" src="art/lobby-portraits.png"/></div><div class="lobby-slot-info"><h2 id="lobby-name-2"></h2><div id="lobby-state-2" class="lobby-state"></div><select id="lobby-bot-team-2" class="bot-team"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></select><button id="lobby-slot-action-2" class="slot-action"></button></div></div>
<div id="lobby-slot-3" class="lobby-slot"><div class="lobby-portrait"><img id="lobby-portrait-3" src="art/lobby-portraits.png"/></div><div class="lobby-slot-info"><h2 id="lobby-name-3"></h2><div id="lobby-state-3" class="lobby-state"></div><select id="lobby-bot-team-3" class="bot-team"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></select><button id="lobby-slot-action-3" class="slot-action"></button></div></div>
<div id="lobby-slot-4" class="lobby-slot"><div class="lobby-portrait"><img id="lobby-portrait-4" src="art/lobby-portraits.png"/></div><div class="lobby-slot-info"><h2 id="lobby-name-4"></h2><div id="lobby-state-4" class="lobby-state"></div><select id="lobby-bot-team-4" class="bot-team"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></select><button id="lobby-slot-action-4" class="slot-action"></button></div></div>
<div id="lobby-slot-5" class="lobby-slot"><div class="lobby-portrait"><img id="lobby-portrait-5" src="art/lobby-portraits.png"/></div><div class="lobby-slot-info"><h2 id="lobby-name-5"></h2><div id="lobby-state-5" class="lobby-state"></div><select id="lobby-bot-team-5" class="bot-team"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></select><button id="lobby-slot-action-5" class="slot-action"></button></div></div>
</div><div id="lobby-lower"><div id="lobby-world-preview"><img src="art/lobby-valley.png"/><div id="lobby-world-caption"></div></div>
<div id="lobby-settings"><h2 id="lobby-settings-title"></h2><p id="lobby-coop"></p><div id="lobby-rules"></div><label id="lobby-team-label">Your team</label><select id="lobby-team"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></select><label id="lobby-address-label" for="lobby-address-select">LAN / VPN address</label><select id="lobby-address-select"></select><p id="lobby-address"></p></div></div>
<div id="lobby-actions"><button id="lobby-leave">Leave</button><button id="lobby-invite">Copy address</button><button id="lobby-ready">Ready</button><button id="lobby-start">Start game</button></div>
</div></div>
</body></rml>
