<rml>
<head>
    <link type="text/rcss" href="ribterra.rcss"/>
    <link type="text/rcss" href="art/theme.rcss"/>
    <link type="text/rcss" href="concept.rcss"/>
    <link type="text/rcss" href="building-panels.rcss"/>
    <link type="text/rcss" href="hud-v01.rcss"/>
</head>
<body class="hud-v01">
    <div id="topbar" class="hud-v01-panel">
        <button class="resource" id="resource-wood"><img class="resource-icon" sprite="hud-resource-wood"/><span class="resource-copy"><span id="wood-label" class="resource-label">wood</span><span id="wood-short-label" class="resource-label-compact">wood</span><span class="resource-count" id="wood">0</span></span></button>
        <button class="resource" id="resource-stone"><img class="resource-icon" sprite="hud-resource-stone"/><span class="resource-copy"><span id="stone-label" class="resource-label">stone</span><span id="stone-short-label" class="resource-label-compact">stone</span><span class="resource-count" id="stone">0</span></span></button>
        <button class="resource" id="resource-food"><img class="resource-icon" sprite="hud-resource-food"/><span class="resource-copy"><span id="food-label" class="resource-label">food</span><span id="food-short-label" class="resource-label-compact">food</span><span class="resource-count" id="food">0</span></span></button>
        <button class="resource" id="settlement-open"><img class="resource-icon" sprite="hud-resource-people"/><span class="resource-copy"><span id="population-label" class="resource-label">people</span><span id="population-short-label" class="resource-label-compact">people</span><span class="resource-count" id="population"></span></span></button>
    </div>

    <div id="deferred-resources" class="hidden">
        <div class="resource future-resource" id="resource-coal"><span id="coal-label">coal</span><span id="coal">0</span></div>
        <div class="resource future-resource" id="resource-iron"><span id="iron-label">iron</span><span id="iron">0</span></div>
        <div class="resource future-resource" id="resource-copper"><span id="copper-label">copper</span><span id="copper">0</span></div>
        <div class="resource future-resource" id="resource-gold"><span id="gold-label">gold</span><span id="gold">0</span></div>
        <div class="resource future-resource" id="resource-silver"><span id="silver-label">silver</span><span id="silver">0</span></div>
        <div class="resource future-resource" id="resource-steel"><span id="steel-label">steel</span><span id="steel">0</span></div>
        <div class="resource future-resource" id="resource-crystals"><span id="crystals-label">crystals</span><span id="crystals">0</span></div>
        <div id="temperature-panel"><span id="temperature"></span></div>
    </div>

    <div id="layerbar" class="hud-v01-panel"><strong id="hud-title">Ribterra</strong><div class="calendar"><img id="season-icon" class="resource-icon" src="art/icons-cursors.16.png"/><div class="calendar-text"><span id="season"></span><span id="day"></span></div></div></div>

    <div id="food-warning" class="hud-v01-panel hidden"><img class="warning-icon" src="art/icons-cursors.2.png"/><div class="warning-copy"><strong id="food-warning-title"></strong><span id="food-warning-detail"></span></div><button id="food-warning-action"></button></div>

    <div id="selection-panel" class="card hud-v01-inspector hidden">
        <h2 id="selection-title">Selection</h2><div id="resident-name"></div><div id="selection-count"></div><div id="resident-order"></div><div id="resident-health-reason" class="hidden"></div><button id="selection-details"></button>
        <div id="selection-detail-body" class="hidden"><div id="resident-layer"></div><div id="selection-pending"></div><div id="resident-order-detail"></div><div id="resident-carry"></div><div id="resident-logistics"></div><div id="resident-logistics-failure"></div><div id="resident-work" class="hidden"></div><div id="resident-work-detail" class="hidden"></div><div id="resident-health"></div><div id="resident-hunger"></div><div id="resident-age"></div><div id="resident-production"></div><button id="orders-open">Orders and control</button><button id="profession-open">Profession and skills</button><button id="use-passage">Use passage</button></div>
    </div>

    <div id="building-summary" class="card hud-v01-inspector hidden"><button id="building-summary-close" class="inspector-close">×</button><div class="building-summary-layout"><img id="building-summary-art" src="art/building-house.png"/><div class="building-summary-copy"><h2 id="building-summary-title"></h2><div id="building-summary-level"></div><div id="building-summary-state"></div><div id="building-summary-reason"></div><div id="building-summary-storage" class="hidden"><div class="storage-summary-line"><span id="building-summary-storage-label"></span><b id="building-summary-storage-value"></b></div><div class="storage-summary-meter"><div id="building-summary-storage-fill"></div></div></div><button id="building-summary-details"></button></div></div></div>

    <div id="action-strip" class="hud-v01-panel"><button id="action-build"><img sprite="hud-action-build"/><span></span></button><button id="action-gather"><img sprite="hud-action-gather"/><span></span></button><button id="action-assign"><img sprite="hud-action-assign"/><span></span></button><button id="action-cancel"><img sprite="hud-action-cancel"/><span></span></button><div id="action-strip-hint" class="hidden" role="status" aria-live="polite"></div></div>

    <div id="controls" class="card"><div class="minimap-rail-gap"></div><div class="minimap-frame frame-top"></div><div class="minimap-frame frame-bottom"></div><div class="minimap-frame frame-left"></div><div class="minimap-frame frame-right"></div><div id="minimap-hit" role="img"></div><div id="time-controls"><button id="pause">II</button><button id="speed-1">1x</button><button id="speed-2">2x</button><button id="hud-settings-toggle"><img src="art/glyph-4.png"/></button></div><div id="system-controls" class="hidden"><button id="surface-tab">Surface</button><button id="mine-tab">Mine</button><button id="speed-4">4x</button><button id="economy-open">Production</button><button id="save">Save</button><button id="load">Load</button><button id="hud-help">Help</button><button id="hud-menu">Menu</button></div></div>

    <div id="status" class="card"></div>
    <div id="menu-rail" class="card hidden"><button id="build-more">Buildings</button><button id="stocks-toggle">Resources</button></div>

    <div id="stocks-panel" class="card hidden"><h2 id="stocks-title">Settlement stocks</h2><div id="stocks-body" tabindex="0"><div id="stocks-explanation"></div><div id="stocks-table"></div><div id="future-resources-note"></div><div id="stocks-carrying"></div><h2 id="deliveries-title">Building deliveries</h2><div id="deliveries-list"></div><div id="delivery-pages"><button id="delivery-prev">Previous</button><span id="delivery-page"></span><button id="delivery-next">Next</button></div></div><button id="stocks-close">Close</button></div>
    <div id="chat" class="card hidden"><h2 id="chat-title">Settlement chat</h2><div id="chat-log"></div><input id="chat-input" maxlength="1024"/><button id="chat-send">Send</button></div>

    <div id="profession-panel" class="card hidden"><h2 id="profession-title">Profession and skills</h2><div id="profession-person"></div><div id="profession-state"></div><div id="profession-form"><label id="profession-label" for="profession-select">Profession</label><select id="profession-select"></select><div id="profession-priority-hint"></div><div id="profession-priorities"><div class="profession-priority"><label id="priority-label-0" for="priority-0"></label><select id="priority-0"></select></div><div class="profession-priority"><label id="priority-label-1" for="priority-1"></label><select id="priority-1"></select></div><div class="profession-priority"><label id="priority-label-2" for="priority-2"></label><select id="priority-2"></select></div><div class="profession-priority"><label id="priority-label-3" for="priority-3"></label><select id="priority-3"></select></div><div class="profession-priority"><label id="priority-label-4" for="priority-4"></label><select id="priority-4"></select></div></div><div id="profession-buttons"><button id="profession-apply">Assign automatically</button><button id="profession-worksite">Choose worksite</button><button id="profession-stop">Stop work</button></div><h2 id="profession-skills-title">Skills</h2><div id="profession-skill-list"><button class="profession-skill" id="profession-skill-0"></button><button class="profession-skill" id="profession-skill-1"></button><button class="profession-skill" id="profession-skill-2"></button><button class="profession-skill" id="profession-skill-3"></button><button class="profession-skill" id="profession-skill-4"></button><button class="profession-skill" id="profession-skill-5"></button><button class="profession-skill" id="profession-skill-6"></button><button class="profession-skill" id="profession-skill-7"></button></div><div id="profession-breakdown"></div><div id="profession-skill-hint"></div></div><button id="profession-close">Close</button></div>

    <div id="orders-panel" class="card hidden"><h2 id="orders-title">Orders and control</h2><div id="orders-person"></div><div id="orders-control"></div><div id="orders-body"><div id="orders-hint"></div><label id="orders-gather-label" for="orders-gather">Next gathering order</label><select id="orders-gather"></select><div id="orders-policy-hint"></div><h2 id="orders-queue-title">Selected settler's orders</h2><div id="orders-list"></div><div id="orders-authority"><label id="orders-player-label" for="orders-player">Transfer control to</label><select id="orders-player"></select><div id="orders-control-buttons"><button id="orders-transfer">Transfer control</button><button id="orders-release">Release control</button></div><div id="orders-release-hint"></div></div></div><button id="orders-close">Close</button></div>

    <div id="building-catalog" class="card hidden"><button id="catalog-close">Close</button><strong id="catalog-title">Buildings</strong><div id="buildbar"><button id="catalog-all">Buildings</button><button id="nav-civic">Settlement</button><button id="nav-production">Production</button><button id="nav-defense">Defense</button><button id="nav-landscape">Land</button><button id="build-bridge">Bridges</button></div><div id="farm-help"></div><div id="bridge-help"></div><div id="catalog-grid"><button id="catalog-house" class="building-card"></button><button id="catalog-farm" class="building-card"></button><button id="catalog-stockpile" class="building-card"></button><button id="catalog-mine" class="building-card"></button><button id="catalog-workshop" class="building-card"></button><button id="catalog-temple" class="building-card"></button><button id="catalog-tavern" class="building-card"></button><button id="catalog-cartographer" class="building-card"></button><button id="catalog-research" class="building-card"></button><button id="catalog-smelter" class="building-card"></button><button id="catalog-fishing" class="building-card"></button><button id="catalog-library" class="building-card"></button><button id="catalog-barracks" class="building-card"></button><button id="catalog-lumbermill" class="building-card"></button><button id="catalog-mill" class="building-card"></button><button id="catalog-kitchen" class="building-card"></button><button id="catalog-claypit" class="building-card"></button><button id="catalog-bridge" class="building-card"></button></div></div>

    <div id="settlement-panel" class="card hidden"><h2 id="settlement-title"></h2><div id="settlement-body"><div id="settlement-discontent"></div><div id="settlement-discontent-meter" class="settlement-meter"><div id="settlement-meter-fill"></div></div><div id="settlement-causes"></div><p id="settlement-schedule"></p><p id="settlement-night-hint"></p><button id="settlement-night"></button><h2 id="settlement-population-title"></h2><p id="settlement-recruit-hint"></p><button id="settlement-recruit"></button><p id="settlement-arrival"></p><div id="settlement-youth"></div><p id="settlement-enterprises"></p></div><button id="settlement-close"></button></div>
    <div id="economy-panel" class="card hidden"><h2 id="economy-title"></h2><div id="economy-worker"></div><label id="economy-quantity-label"></label><select id="economy-quantity"><option value="1">1</option><option value="5">5</option><option value="10">10</option><option value="20">20</option></select><div id="economy-body"><div id="economy-stock"></div><div id="economy-sites"></div></div><button id="economy-close"></button></div>

    <div id="building-panel" class="hidden"><button id="bp-close">×</button><div class="bp-header"><img id="bp-art" class="bp-art" src="art/building-house.png"/><div><h1 id="bp-title">House</h1><div id="bp-level" class="bp-level">Level I</div></div></div><p id="bp-purpose"></p><div id="bp-owner"></div><div class="bp-section"><div id="bp-status"></div><p id="bp-info"></p><div id="bp-group-feedback" tabindex="0"></div><div id="bp-stats"></div></div><div class="bp-section"><div id="bp-form"><div class="bp-row"><span id="bp-recipe-label">Recipe</span><select id="bp-recipe"></select></div><div class="bp-row"><span id="bp-quantity-label">Quantity</span><input id="bp-quantity" type="text" value="1" maxlength="2"/></div></div><div id="bp-worker-controls"><div class="bp-row" id="bp-worker-row"><span id="bp-worker-label">Worker</span><select id="bp-worker"></select></div><p id="bp-worker-detail"></p><button id="bp-worker-manage" class="bp-secondary">Manage worker</button></div><p id="bp-batches-hint"></p><div id="bp-extra"></div><div id="bp-scope-row" class="bp-row"><span id="bp-scope-label">Apply to</span><select id="bp-scope"><option value="this">This building</option><option value="selected">Selected of this type</option><option value="all">All of this type</option></select></div><button id="bp-main" class="bp-main"></button><p id="bp-feedback"></p></div><div id="bp-upgrade" tabindex="0"><div><div id="bp-upgrade-name">House II</div><p id="bp-upgrade-note"></p><p id="bp-upgrade-cost"></p><p id="bp-upgrade-hint"></p></div><button id="bp-upgrade-start" class="bp-main"></button><button id="bp-research">View Research</button></div></div>
    <div id="building-research" class="hidden"><button id="br-close">×</button><h1>Choose Research</h1><p>Choose what your settlement needs.</p><div class="br-layout"><div id="br-cards"></div><div id="br-detail"><h2 id="br-name">House II</h2><p id="br-description"></p><p>Research time: Unavailable</p><p>Resource cost: Unavailable</p><p>Research simulation is not implemented yet.</p><button id="br-start" disabled="disabled">Start Research</button><p>Research unlocks an upgrade. Building work is separate.</p></div></div></div>
</body>
</rml>
